# Public site URL (used for metadata, Open Graph, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# API base URL (optional; leave empty for same-origin relative URLs)
# NEXT_PUBLIC_API_URL= is used in the browser
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Server-side only: use when backend is on another host (e.g. internal API_URL for SSR)
API_URL=https://selectify.alwis.dev

# Product/variant image files base URL (images load as {base}/products/{file_id})
# Hostname must be allowlisted in next.config.js images.remotePatterns (read from this env at build time)
NEXT_PUBLIC_PRODUCT_FILES_BASE_URL=https://cdn.selectify.alwis.dev

#Stripe Payment gateway key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=test_key