EVT_DB_HOST=localhost
EVT_DB_PORT=5432
EVT_DB_DATABASE=selectify
EVT_DB_MAX_IDLE=5
EVT_DB_MAX_OPEN=25
EVT_DB_MAX_LIFETIME=5m

# Read-Write Database Credentials
EVT_DB_RW_USER=selectify_rw
EVT_DB_RW_PASSWORD=passVVord

# Read-Only Database Credentials
EVT_DB_RO_USER=selectify_ro
EVT_DB_RO_PASSWORD=passVVrd

EVT_SQS_QUEUE_URL=https://sqs.<region>.amazonaws.com/<account>/<queue>
EVT_SQS_REGION=us-east-1
EVT_SQS_ACCESS_KEY_ID=
EVT_SQS_SECRET_ACCESS_KEY=
# Short poll (0) + POLL_INTERVAL yields ~30s retrieve cadence. Wait max is 20 (AWS limit).
EVT_SQS_WAIT_TIME_SECONDS=0
EVT_SQS_POLL_INTERVAL_SECONDS=30
EVT_SQS_MAX_MESSAGES=10
